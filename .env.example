# ==============================================================================
# Local demo environment. Copy this file to .env, then set MINIO_LICENSE_FILE.
# The defaults match the repository's compose.yaml and ui/.env.local.example.
# Copy this file to .env and configure your environment variables:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relational database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL relational store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riverview_admissions
# The policy loader, dossier agent, and UI use these same connection details.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riverview_admissions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. Object storage (MinIO S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=admissions-raw-docs
# Required only when starting the repo's local Compose stack.
# Download a free-tier MinIO AIStor license, then set its absolute file path.
MINIO_LICENSE_FILE=

# 3. Active dossier generator, policy embeddings, and Next.js chat
# ------------------------------------------------------------------------------
VLM_MODEL=qwen3-vl:8b-instruct
OLLAMA_MODEL=qwen3-vl:8b-instruct
EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_EMBED_URL=http://localhost:11434/api/embed

# ------------------------------------------------------------------------------
# 4. Ingestion API scheduling
# ------------------------------------------------------------------------------
# Autonomous overnight cron schedule (server local time)
BATCH_CRON_HOUR=2
BATCH_CRON_MINUTE=0

# The API and overnight scheduler require shared PostgreSQL and live MinIO for handoff.
# Set these to false only for a local dry-run that will not feed the summary agent.
INGESTION_REQUIRE_POSTGRESQL=true
INGESTION_REQUIRE_OBJECT_STORAGE=true

# ------------------------------------------------------------------------------
# 5. Optional older gateway/grounding module (not used by the dossier agent)
# ------------------------------------------------------------------------------
LLM_MODEL=qwen2.5:14b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
