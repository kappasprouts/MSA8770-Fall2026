# ==============================================================================
# Riverview State University Admissions Pipeline - Environment Configuration
# Copy this file to .env and configure your environment variables:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Selection & LLM Gateway Configuration
# ------------------------------------------------------------------------------
# Choose which model the Model Gateway will invoke:
# Options include local Ollama models (e.g., qwen2.5:14b-instruct, gpt-oss-20b,
# qwen2.5:7b) or external models (e.g., gpt-4o-mini).
LLM_MODEL=qwen2.5:14b-instruct

# Base URL of your LLM server:
# - For local Ollama container: http://localhost:11434
# - For OpenAI-compatible endpoints: https://api.openai.com/v1
# - For other hosted providers: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434

# API Key for LLM provider:
# - Leave blank/empty if using default local Ollama (no auth required)
# - Set your API key if using OpenAI, OpenRouter, Groq, DeepSeek, or authenticated Ollama
LLM_API_KEY=

# Alternatively, provider-specific keys are also automatically detected:
# OPENAI_API_KEY=
# OLLAMA_API_KEY=

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL relational store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riverview_admissions

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO S3 Archival)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=admissions-raw-docs

# ------------------------------------------------------------------------------
# 4. Ingestion Layer Scheduling
# ------------------------------------------------------------------------------
# Autonomous overnight cron schedule (UTC time)
BATCH_CRON_HOUR=2
BATCH_CRON_MINUTE=0

# The API and overnight scheduler require shared PostgreSQL and live MinIO for handoff.
# Set these to false only for a local dry-run that will not feed the summary agent.
INGESTION_REQUIRE_POSTGRESQL=true
INGESTION_REQUIRE_OBJECT_STORAGE=true
