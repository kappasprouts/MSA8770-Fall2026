# PostgreSQL used by the ingestion and summarizing workflows
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riverview_admissions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO containing the original applicant PDFs
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=applicant-documents

# Optional officer Q&A model endpoint
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
