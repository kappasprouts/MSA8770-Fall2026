# Copy to .env.local and adjust if your services run elsewhere.

OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b-instruct

# Same PostgreSQL database as DATABASE_URL and POSTGRES_* in the root .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riverview_admissions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Same MinIO endpoint and bucket used by ingestion and the summarizing agent.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=admissions-raw-docs
