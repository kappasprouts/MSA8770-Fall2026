# Copy to .env.local and adjust if your services run elsewhere.

OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b-instruct

# Same Postgres the Summarizing Agent writes to (see ../README.md section 3.4).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riverview_admissions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Same MinIO the Summarizing Agent reads PDFs from (see ../README.md section 3.5/4.3).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=applicant-documents
